# Copy to .env and fill in ONE of these. All are free.

# Recommended: Groq (free tier, very fast). Key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=

# Alternative: Google Gemini (free tier). Key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Alternative: OpenRouter ":free" models. Key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Offline / private: Ollama on this machine, no key needed.
# LLM_PROVIDER=ollama

# Optional overrides
# LLM_MODEL=
# AWA_BATCH_SIZE=8
# AWA_LLM_CONCURRENCY=2
